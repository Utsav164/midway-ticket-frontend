# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://YOUR-FRONTEND-DOMAIN
NEXT_PUBLIC_APP_NAME=MidwayTicket

# ── API — the live backend's versioned base ───────────────────────────────────
# Your current deployed backend has URI versioning ON (main.ts), so every
# route except /health is under /api/v1 (e.g. /api/v1/auth/login/customer).
# If you later remove versioning backend-side, update this to /api instead.
NEXT_PUBLIC_API_URL=https://midway-ticket-backend-production.up.railway.app/api/v1

# ── Mock mode — MUST be false (or unset) in production ────────────────────────
NEXT_PUBLIC_USE_MOCK_API=false

# For local development against a locally-run backend, use instead:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# NEXT_PUBLIC_USE_MOCK_API=true
